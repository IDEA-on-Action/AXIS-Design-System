# pnpm configuration
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# Enable workspace protocol
link-workspace-packages=true
shared-workspace-lockfile=true

# npm 인증은 이 파일에 두지 않는다:
# - 로컬 publish: ~/.npmrc의 authToken 사용
# - CI publish: changesets/action이 NPM_TOKEN secret으로 $HOME/.npmrc 자동 생성
# (pnpm 9.15.4가 ${NPM_TOKEN} 기본값 문법 미지원 - 미설정 시 매 명령 WARN 발생하여 제거, 2026-08-07)
