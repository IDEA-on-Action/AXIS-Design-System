{
  "name": "axis-design-system",
  "version": "1.2.0",
  "private": true,
  "description": "AXIS Design System - React 컴포넌트 라이브러리 및 디자인 토큰",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.6",
      "@types/react-dom": "^19.0.2"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @ax/web dev",
    "dev:web": "pnpm --filter @ax/web dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @ax/web build",
    "build:registry": "node scripts/build-registry.mjs",
    "test:registry": "node --test scripts/registry-integrity.test.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "pnpm -r clean && rm -rf node_modules .turbo",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "pack-smoke": "node scripts/pack-smoke.mjs && node scripts/pack-install-smoke.mjs",
    "registry-install-smoke": "node scripts/registry-install-smoke.mjs",
    "registry-install-smoke:all": "node scripts/registry-install-smoke.mjs --items all --jobs 2",
    "cli-smoke": "node scripts/cli-bundled-smoke.mjs",
    "registry-shadcn-smoke": "node scripts/registry-shadcn-smoke.mjs",
    "release": "pnpm build && pnpm pack-smoke && changeset publish",
    "check-licenses": "node scripts/check-licenses.mjs",
    "check-token-refs": "node scripts/check-token-refs.mjs",
    "check-contrast-pairs": "node scripts/check-contrast-pairs.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "9.39.2",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "14.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
