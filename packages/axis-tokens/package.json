{
  "name": "@axis-ds/tokens",
  "version": "1.5.1",
  "description": "AXIS Design System - Design Tokens (CSS Variables + JSON)",
  "main": "dist/js/tokens.js",
  "module": "dist/js/tokens.mjs",
  "types": "dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "import": "./dist/js/tokens.mjs",
      "require": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/variables.css",
    "./css/shadcn": "./dist/css/shadcn-compat.css",
    "./css/tailwind4": "./dist/css/tailwind4.css",
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.js"
    },
    "./json": "./dist/json/tokens.json",
    "./brands": "./dist/brands/index.json",
    "./css/brands/ontology": "./dist/css/brands/ontology.css",
    "./brands/ontology/brand.json": "./dist/brands/ontology/brand.json"
  },
  "typesVersions": {
    "*": {
      "tailwind": [
        "./dist/tailwind-preset.d.ts"
      ],
      "json": [
        "./dist/json/tokens.json"
      ],
      "brands": [
        "./dist/brands/index.json"
      ],
      "brands/ontology/brand.json": [
        "./dist/brands/ontology/brand.json"
      ]
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build-tokens.mjs && tsup src/tailwind-preset.ts --format cjs,esm --dts --out-dir dist",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "node --test test/theme-modes.test.mjs test/dark-completeness.test.mjs test/no-css-opacity.test.mjs test/brands.test.mjs test/build-brands.test.mjs test/baseline-1.2.1.test.mjs test/ontology-values.test.mjs test/js-entry.test.mjs test/tailwind4.test.mjs",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json && node scripts/check-ts-optin.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "style-dictionary": "^4.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "design-system",
    "axis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IDEA-on-Action/AXIS-Design-System.git",
    "directory": "packages/axis-tokens"
  },
  "homepage": "https://axis-design-system.pages.dev"
}
