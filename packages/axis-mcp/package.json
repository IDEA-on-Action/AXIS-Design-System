{
  "name": "@axis-ds/mcp",
  "version": "1.3.3",
  "type": "module",
  "description": "AXIS Design System - MCP Server for AI-assisted component discovery",
  "bin": {
    "axis-mcp": "./dist/index.js"
  },
  "main": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "src/registry/data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && npm run copy-data && npm run copy-registry",
    "copy-data": "node -e \"const fs=require('fs');fs.cpSync('src/registry/data','dist/data',{recursive:true})\"",
    "copy-registry": "node ../axis-cli/scripts/copy-registry.mjs ../../apps/web/public/r dist/registry",
    "dev": "tsup src/index.ts --format esm --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axis-ds/registry-core": "workspace:*",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "design-system",
    "axis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IDEA-on-Action/AXIS-Design-System.git",
    "directory": "packages/axis-mcp"
  },
  "homepage": "https://axis-design-system.pages.dev"
}
