{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/templates/theme-only.json",
        "$TURBO_ROOT$/apps/web/templates/*/files/package.json",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/docs/guides/**",
        "$TURBO_ROOT$/README.md"
      ]
    }
  }
}
